<service>
  <id>KestrelGateway</id>
  <name>Kestrel Gateway</name>
  <description>Watches the AV devices at this site and reports to Kestrel. Restarts on its own if it stops.</description>
  <executable>%BASE%\app\runtime\node.exe</executable>
  <arguments>__ARGS__</arguments>
  <workingdirectory>%BASE%\app</workingdirectory>
__ENV__
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>1</keepFiles>
  </log>
  <logpath>__LOGPATH__</logpath>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <stoptimeout>15 sec</stoptimeout>
</service>
