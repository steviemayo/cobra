generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  dev
  support
  customer_viewer
}

enum RoomType {
  meeting
  training
}

enum GatewayStatus {
  pending
  online
  offline
}

enum GatewayChannel {
  stable
  beta
}

model Org {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  createdAt          DateTime @default(now())
  /// When true, staff can only open a support session if they link one of this organisation's open tickets.
  staffAccessBlocked Boolean  @default(false)
  /// customer: an organisation with rooms. msp: a managed service provider that looks after customers.
  kind               String   @default("customer")

  members             Member[]
  sites               Site[]
  gateways            Gateway[]
  rooms               Room[]
  audit               AuditLog[]
  retention           OrgRetention?
  commissioningRuns   CommissioningRun[]
  apiKeys             ApiKey[]
  reportSchedule      ReportSchedule?
  drafts              RoomDraft[]
  draftVersions       RoomDraftVersion[]
  templates           Template[]
  invites             Invite[]
  releases            Release[]
  gatewayEvents       GatewayEvent[]
  deployments         Deployment[]
  deviceStatus        DeviceStatus[]
  incidents           Incident[]
  alertChannels       AlertChannel[]
  alertDeliveries     AlertDelivery[]
  commands            RemoteCommand[]
  tickets             Ticket[]
  ticketComments      TicketComment[]
  branding            Json?
  billing             OrgBilling?
  controlIntents      ControlIntent[]
  controlSessions     ControlSession[]
  roomGroups          RoomGroup[]
  licenseOverrides    OrgLicenseOverride[]
  notes               OrgNote[]
  grantsToProviders   MspGrant[]            @relation("CustomerSide")
  grantsFromCustomers MspGrant[]            @relation("MspSide")
  calendars           CalendarConnection[]
  listings            MarketplaceListing[]
  purchases           MarketplacePurchase[]
  customDrivers       CustomDriver[]
  roomBindings        RoomBinding[]
  credentialSets      CredentialSet[]
  siteDevices         SiteDevice[]
  joinRequests        JoinRequest[]
  areas               Area[]
  devices             Device[]
  deviceEvents        DeviceEvent[]
}

model Member {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String   @db.Uuid // Supabase auth.users.id
  email     String? // denormalised from auth.users for the team list
  role      OrgRole
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  timezone  String   @default("Australia/Sydney")
  createdAt DateTime @default(now())

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gateways    Gateway[]
  rooms       Room[]
  groups      RoomGroup[]
  siteDevices SiteDevice[]
  areas       Area[]
  devices     Device[]

  @@index([orgId])
}

model Gateway {
  id                   String         @id @default(uuid()) @db.Uuid
  orgId                String         @db.Uuid
  siteId               String         @db.Uuid
  name                 String
  status               GatewayStatus  @default(pending)
  enrollTokenHash      String?
  enrollTokenExpiresAt DateTime?
  credentialHash       String?        @unique
  enrolledAt           DateTime?
  version              String?
  channel              GatewayChannel @default(stable)
  hostname             String?
  os                   String?
  /// What the gateway said it can do in its last heartbeat (for example "bindings"). Empty for older gateways.
  features             String[]       @default([])
  /// When true the portal asks this gateway to update as soon as its channel has a newer version.
  autoUpdate           Boolean        @default(false)
  /// An update someone asked for, to `updateVersion`, not before this time. Null when none is waiting.
  updateNotBefore      DateTime?
  updateVersion        String?
  /// How the gateway last said it got on (downloading, staged, applying, failed, unsupported), and why it failed.
  updateState          String?
  updateError          String?
  updateReportedAt     DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime       @default(now())

  org     Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site    Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rooms   Room[]
  events  GatewayEvent[]
  devices Device[]

  @@index([orgId])
  @@index([siteId])
}

/// A gateway that is running but has no definition in any organisation: it announced itself, and
/// staff can give it to the right organisation once they have confirmed with the customer.
model UnclaimedGateway {
  id               String    @id @default(uuid()) @db.Uuid
  /// Random and public, chosen by the install. The secret proves it is the same install later.
  installId        String    @unique
  secretHash       String
  hostname         String?
  os               String?
  version          String?
  localAddresses   String[]  @default([])
  /// The address the cloud saw the announcement come from, to help tell which customer it is.
  publicIp         String?
  /// open, claimed, dismissed.
  status           String    @default("open")
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  claimedGatewayId String?   @db.Uuid
  claimedBy        String?   @db.Uuid
  claimedAt        DateTime?
  /// The enrolment token of the gateway made from the claim, sealed; handed to the install until it enrols.
  claimTokenSealed String?

  @@index([status, lastSeenAt])
  @@index([publicIp, firstSeenAt])
}

model Room {
  id                      String    @id @default(uuid()) @db.Uuid
  orgId                   String    @db.Uuid
  siteId                  String    @db.Uuid
  gatewayId               String?   @db.Uuid
  name                    String
  type                    RoomType
  createdAt               DateTime  @default(now())
  panel                   Json?
  /// The room group this room belongs to, if it can be physically joined to other rooms.
  groupId                 String?   @db.Uuid
  /// standard: an ordinary room. combined: the room that exists while `memberRoomIds` are joined.
  /// Only standard rooms are billed.
  kind                    String    @default("standard")
  memberRoomIds           String[]  @default([]) @db.Uuid
  /// A room that is only watched: its design warnings are not shown as something to fix.
  monitorOnly             Boolean   @default(false)
  /// The area (building, level, zone) the room sits in, when the customer groups rooms that way.
  areaId                  String?   @db.Uuid
  /// Free labels for cross-cutting groups ("boardroom", "VIP").
  tags                    String[]  @default([])
  /// Hash of the secret webhook callers present. Null until someone generates one.
  hookSecretHash          String?
  desiredReleaseId        String?   @db.Uuid
  desiredDeploymentId     String?   @db.Uuid
  reportedReleaseId       String?   @db.Uuid
  reportedHash            String?
  /// Version of the room's bindings the gateway is running with. Compared with RoomBinding.version.
  reportedBindingsVersion Int?
  reportedStatus          String?
  reportedError           String?
  reportedAt              DateTime?
  updatedAt               DateTime  @default(now()) @updatedAt

  org               Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gateway           Gateway?           @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  group             RoomGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  area              Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assets            Device[]
  draft             RoomDraft?
  binding           RoomBinding?
  releases          Release[]
  commissioningRuns CommissioningRun[]
  deployments       Deployment[]
  devices           DeviceStatus[]
  incidents         Incident[]
  commands          RemoteCommand[]
  tickets           Ticket[]

  @@index([orgId])
  @@index([siteId])
  @@index([groupId])
  @@index([areaId])
}

// A room's addresses and logins, kept apart from its design so templates carry none of them, an IP
// change needs no new release and a password can be rotated in one place. See docs/driver-classes.md.
model RoomBinding {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  roomId         String   @unique @db.Uuid
  /// Goes up on every change, including a change to a credential set this room uses.
  version        Int      @default(1)
  /// device id -> { setting key -> value }: addresses and other bindings that are not secret.
  values         Json     @default("{}")
  /// Sealed with KESTREL_SECRETS_KEY: JSON of device id -> { setting key -> value } for secrets. Never sent to a browser.
  sealed         String?
  /// device id -> credential set id. The set's fields sit under the device's own values.
  credentialSets Json     @default("{}")
  updatedBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// One physical device known to a site, used by any number of rooms (a matrix or DSP serving two rooms,
// a shared codec). Rooms refer to it from their design; its address and login live here once. See
// docs/driver-classes.md, "Shared devices".
model SiteDevice {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  siteId          String   @db.Uuid
  name            String
  /// The device category, so a room that uses it can be checked without asking the device.
  category        String
  /// How it is controlled: { kind: "driver", driverId } or { kind: "generic", protocol }.
  control         Json
  /// Design settings every room shares (not addresses or logins).
  settings        Json     @default("{}")
  /// Addresses, like RoomBinding.values but for this one device: setting key -> value.
  values          Json     @default("{}")
  /// Logins sealed with KESTREL_SECRETS_KEY: setting key -> value. Never sent to a browser.
  sealed          String?
  credentialSetId String?  @db.Uuid
  /// A device that can serve only one room at a time (a codec, a recorder): a room in use holds it.
  exclusive       Boolean  @default(false)
  /// Goes up on every change to its address or login, so every room that uses it gets new bindings.
  version         Int      @default(1)
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([orgId])
}

// A login shared by many devices ("Site X Q-SYS admin"). `sealed` holds JSON of setting key -> value,
// sealed with KESTREL_SECRETS_KEY. Only the field names are ever sent to a browser.
model CredentialSet {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  sealed    String
  /// The names of the fields in `sealed`, for display.
  fields    String[] @default([])
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

// How long an organisation's activity log is kept. No row means the default (12 months). Only staff
// change it; the daily retention job reads it. Billing and access-change events are kept longer.
model OrgRetention {
  orgId     String   @id @db.Uuid
  auditDays Int      @default(365)
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// One walk through a room to check it works, and who signed it off. `items` is the checklist made
// from the room's design when the run started: [{ id, group, label, hint?, result, note? }] with
// result pending, pass, fail or skip. A signed-off run never changes.
model CommissioningRun {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @db.Uuid
  roomId           String    @db.Uuid
  /// The release the room was set to run when the check started.
  releaseNumber    Int?
  items            Json
  status           String    @default("in_progress")
  startedBy        String?   @db.Uuid
  startedByEmail   String?
  startedAt        DateTime  @default(now())
  signedOffBy      String?   @db.Uuid
  signedOffByEmail String?
  signedOffAt      DateTime?
  notes            String?

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startedAt])
  @@index([orgId])
}

// A key an organisation's own systems use to read its data through the public API (/api/v1). Only
// a hash of the secret is kept: the key is shown once, when it is made.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  name       String
  /// The first characters of the key: recognised in a list, and how a request finds its key.
  prefix     String    @unique
  secretHash String
  createdBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// A monthly usage and reliability report emailed to these addresses on the first days of each month.
// No row means no schedule. `lastSentMonth` ("2026-09") stops a month being sent twice.
model ReportSchedule {
  orgId         String   @id @db.Uuid
  enabled       Boolean  @default(true)
  recipients    String[] @default([])
  /// IANA time zone the month is read in.
  timezone      String   @default("UTC")
  lastSentMonth String?
  updatedBy     String?  @db.Uuid
  updatedAt     DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// One mutable working copy per room. `revision` gives optimistic concurrency for autosave.
model RoomDraft {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  roomId    String   @unique @db.Uuid
  revision  Int      @default(1)
  model     Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room     Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  versions RoomDraftVersion[]

  @@index([orgId])
}

// Named snapshots of a draft (manual checkpoints / restore points).
model RoomDraftVersion {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  draftId   String   @db.Uuid
  revision  Int
  label     String?
  model     Json
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  org   Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  draft RoomDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([orgId])
}

// Org-scoped room templates. Kestrel-global starters live in code (@kestrel/model).
model Template {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String   @default("")
  roomType    RoomType
  model       Json
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Invite links (no email delivery yet). Only the token hash is stored.
model Invite {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  email      String
  role       OrgRole
  tokenHash  String    @unique
  invitedBy  String?   @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// Immutable, signed snapshot of a room's design. `manifest` is the SignedManifest gateways run.
model Release {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  roomId        String   @db.Uuid
  number        Int
  manifest      Json
  hash          String
  /// Which revision of the draft this release froze, to tell when the design has moved on since.
  draftRevision Int?
  /// The shared site devices this release uses, so a gateway's bindings version can be worked out without opening the manifest.
  siteDeviceIds String[] @default([])
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now())

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([roomId, number])
  @@index([orgId])
}

// Telemetry reported by gateways. Retention and rollups arrive with monitoring.
model GatewayEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  gatewayId  String   @db.Uuid
  roomId     String?  @db.Uuid
  type       String
  at         DateTime
  data       Json
  receivedAt DateTime @default(now())

  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId, at])
  @@index([orgId, at])
}

// One attempt to put a release on a room's gateway. `status` is scheduled, pending, one of the
// gateway stages (downloading ... active, failed, rolled_back), cancelled or superseded.
model Deployment {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  roomId       String    @db.Uuid
  releaseId    String    @db.Uuid
  gatewayId    String?   @db.Uuid
  status       String
  /// deploy, or rollback when it re-deploys an older release than the one that was running.
  kind         String    @default("deploy")
  scheduledFor DateTime?
  createdBy    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?

  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room    Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  release Release           @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  events  DeploymentEvent[]

  @@index([roomId, createdAt])
  @@index([orgId, createdAt])
  @@index([status, scheduledFor])
}

// A stage a deployment reached, with the gateway's own timestamp.
model DeploymentEvent {
  id           String   @id @default(uuid()) @db.Uuid
  deploymentId String   @db.Uuid
  stage        String
  at           DateTime

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, stage])
}

// ---- Monitoring & support ---------------------------------------------------------------------

// Latest reachability of each device in a room's running release, as reported by its gateway.
model DeviceStatus {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @db.Uuid
  roomId        String    @db.Uuid
  deviceId      String
  name          String
  online        Boolean
  /// When the device last changed between online and offline.
  since         DateTime
  /// The driver it uses ("pjlink", "custom:my-driver"), as the gateway reports it.
  driver        String?
  /// The firmware version the device reported about itself. Kept when a heartbeat leaves it out.
  firmware      String?
  /// When this firmware version was first seen on the device.
  firmwareSince DateTime?
  /// Whatever the driver reports back (power, input, mute, ...), control or not. See DeviceFeedback.
  feedback      Json?
  /// What the device says about itself (serial, programs, IP table, ...). See DeviceDetails. Kept when a heartbeat leaves it out.
  details       Json?
  updatedAt     DateTime  @default(now()) @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, deviceId])
  @@index([orgId])
}

// Something wrong that a person may need to act on. One open incident per (kind, subject).
// kind: device_offline, gateway_offline, room_fault, deploy_failed. severity: info, warning, critical.
model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  roomId         String?   @db.Uuid
  gatewayId      String?   @db.Uuid
  kind           String
  /// What the incident is about, so the same problem is never opened twice (e.g. "<roomId>:<deviceId>").
  subject        String
  severity       String
  status         String    @default("open")
  title          String
  detail         String?
  openedAt       DateTime
  lastSeenAt     DateTime
  resolvedAt     DateTime?
  /// How many times it has come back inside the flap window.
  occurrences    Int       @default(1)
  /// Whether an "opened" alert went out, so resolution is only announced when the opening was.
  alerted        Boolean   @default(false)
  acknowledgedBy String?   @db.Uuid
  acknowledgedAt DateTime?

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([orgId, status, openedAt])
  @@index([orgId, kind, subject, status])
  @@index([roomId])
}

// Where alerts go. `config` holds the destination (and any signing secret); it is never sent to a browser.
// type: email, teams, webhook, itsm.
model AlertChannel {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  type        String
  config      Json
  minSeverity String   @default("warning")
  enabled     Boolean  @default(true)
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())

  org        Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([orgId])
}

model AlertDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  channelId  String   @db.Uuid
  incidentId String?  @db.Uuid
  /// opened, resolved or test.
  event      String
  /// sent, failed, suppressed or skipped.
  status     String
  error      String?
  at         DateTime @default(now())

  org     Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, at])
  @@index([orgId, at])
}

// A request for a gateway to run an allowlisted command. Delivered in a heartbeat response.
// status: pending, sent, succeeded, failed, expired.
model RemoteCommand {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  gatewayId   String    @db.Uuid
  roomId      String    @db.Uuid
  type        String
  args        Json      @default("{}")
  status      String    @default("pending")
  requestedBy String?   @db.Uuid
  output      Json?
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  finishedAt  DateTime?

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([gatewayId, status])
  @@index([roomId, createdAt])
  @@index([orgId, createdAt])
}

// Support requests, raised by anyone in the org (customers included) and worked by support.
// status: open, in_progress, resolved, closed. priority: low, normal, high, urgent.
model Ticket {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  roomId         String?   @db.Uuid
  incidentId     String?   @db.Uuid
  title          String
  body           String
  status         String    @default("open")
  priority       String    @default("normal")
  createdBy      String?   @db.Uuid
  createdByEmail String?
  assignedTo     String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  closedAt       DateTime?
  /// Who is expected to act: "org" (the organisation's own team), "kestrel" (escalated to Kestrel
  /// staff), or later "msp:<org id>".
  routedTo       String    @default("org")
  escalatedAt    DateTime?
  escalatedBy    String?   @db.Uuid
  /// A Kestrel staff member (StaffUser.userId) working the ticket.
  staffAssignee  String?   @db.Uuid

  org      Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room     Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  comments TicketComment[]

  @@index([orgId, status, createdAt])
  @@index([roomId])
  @@index([routedTo, status, createdAt])
}

model TicketComment {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  ticketId    String   @db.Uuid
  authorId    String?  @db.Uuid
  authorEmail String?
  body        String
  /// public: everyone on the ticket. internal: the organisation's team and Kestrel staff only,
  /// never the organisation's customer viewers.
  visibility  String   @default("public")
  /// Written by Kestrel staff. Shown to the organisation as "Kestrel support", not by name.
  fromStaff   Boolean  @default(false)
  createdAt   DateTime @default(now())

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ---- Billing ----------------------------------------------------------------------------------

// One per organisation. `plan` is what they chose; entitlements are worked out from plan, Stripe
// `status` and `trialEndsAt` (see @kestrel/model billing). Kestrel never stores card details.
model OrgBilling {
  id                   String    @id @default(uuid()) @db.Uuid
  orgId                String    @unique @db.Uuid
  plan                 String    @default("trial")
  /// The Stripe subscription status, or "none" before there is one.
  status               String    @default("none")
  trialEndsAt          DateTime
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripeItemId         String?
  /// Rooms being billed for.
  quantity             Int       @default(0)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @default(now()) @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Stripe events already handled, so a redelivered webhook changes nothing.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---- Control from the portal ------------------------------------------------------------------

// While someone has a room's control page open, the gateway is asked for the room's panel state
// and polled quickly. `snapshot` is the latest PanelViewModel the gateway sent.
model ControlSession {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  roomId       String    @unique @db.Uuid
  lastActiveAt DateTime
  snapshot     Json?
  snapshotAt   DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// A panel intent (start an activity, change volume...) waiting for the gateway to pick it up.
model ControlIntent {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  roomId      String    @db.Uuid
  gatewayId   String    @db.Uuid
  intent      Json
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([gatewayId, deliveredAt])
  @@index([roomId, createdAt])
}

// Rooms that can be joined into one. While combined, the primary's panel controls all of them.
// Staff adjustments to what an organisation may do, on top of what it pays for: extend a trial,
// comp a plan, lift the room limit. The newest one that is not revoked or expired applies. The
// reason is required and stays internal; the organisation sees only that Kestrel adjusted it.
model OrgLicenseOverride {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  /// trial, basic or pro: behave as if the organisation were on that plan. Null: leave the plan alone.
  plan           String?
  /// A new trial end date (with plan trial, or to extend the organisation's own trial).
  trialEndsAt    DateTime?
  maxRooms       Int?
  unlimitedRooms Boolean   @default(false)
  /// Force monitoring on or off. Null: whatever the plan gives.
  monitoring     Boolean?
  expiresAt      DateTime?
  reason         String
  setBy          String    @db.Uuid
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokedBy      String?   @db.Uuid

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// Private notes about an organisation, for staff only.
model OrgNote {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  body      String
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// A staff member working inside a customer organisation ("view-as"). read: they see what support
// sees but cannot change anything. act: they can do what support can. Always has a reason and an
// end time, and no foreign keys so the record outlives the organisation.
model SupportSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  orgId       String    @db.Uuid
  mode        String
  reason      String
  ticketId    String?   @db.Uuid
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  endedAt     DateTime?

  @@index([orgId, startedAt])
  @@index([staffUserId, endsAt])
}

// A managed service provider (an Org of kind "msp") looking after a customer organisation.
// Two-sided: the customer's owner invites, the provider's owner accepts, and either side can end
// it. `siteIds` empty means the whole organisation (site-limited grants come later). `role` is the
// most the provider's people can do: manage (up to dev), support, or view. Never owner: the
// customer keeps billing, team and settings.
model MspGrant {
  id             String    @id @default(uuid()) @db.Uuid
  mspOrgId       String    @db.Uuid
  customerOrgId  String    @db.Uuid
  siteIds        String[]  @default([]) @db.Uuid
  role           String
  /// pending, active, declined or ended
  status         String    @default("pending")
  invitedBy      String    @db.Uuid
  invitedByEmail String?
  respondedBy    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?
  endedAt        DateTime?
  endedBy        String?   @db.Uuid
  /// The customer's owner chose to show this provider's name, logo and colour in its portal and on its panels.
  useBrand       Boolean   @default(false)

  msp      Org @relation("MspSide", fields: [mspOrgId], references: [id], onDelete: Cascade)
  customer Org @relation("CustomerSide", fields: [customerOrgId], references: [id], onDelete: Cascade)

  @@index([customerOrgId, status])
  @@index([mspOrgId, status])
}

// How a service provider presents itself to customers that choose it (white label). No relations,
// like RoomSchedule: it is only ever read by the provider's organisation id.
model ProviderBrand {
  mspOrgId  String   @id @db.Uuid
  name      String
  logoUrl   String?
  accent    String?
  updatedAt DateTime @updatedAt
}

// Kestrel staff: people who may use the /staff portal across every organisation. Separate from
// Member, which is about one organisation. `roles` are admin, support, billing, readonly; admin
// includes all of them.
model StaffUser {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid // Supabase auth.users.id
  email     String?
  roles     String[]
  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
}

// What staff did or looked at, across organisations. No foreign keys, so the record outlives
// an organisation or a staff account.
model StaffAudit {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String   @db.Uuid
  action      String
  orgId       String?  @db.Uuid
  target      String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([staffUserId, createdAt])
}

// Rooms that can be physically joined by movable walls. The combined rooms are ordinary Room rows
// with kind "combined", created from the dividers.
model RoomGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  siteId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  dividers RoomDivider[]
  rooms    Room[]

  @@index([orgId])
  @@index([siteId])
}

// A movable wall. When open it joins every room in `roomIds` into one space.
model RoomDivider {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  name      String
  roomIds   String[] @db.Uuid
  /// What happens to the spaces this wall creates when it opens / closes: off, on, follow or restore.
  onOpen    String   @default("follow")
  onClose   String   @default("off")
  /// Whether the gateway last reported this wall open. The gateway owns the live state.
  open      Boolean  @default(false)
  createdAt DateTime @default(now())

  group RoomGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// ---- Calendars ---------------------------------------------------------------------------------

// How Kestrel reads an organisation's room calendars. `sealed` is the credentials, encrypted with
// KESTREL_SECRETS_KEY; they are never sent to a browser. provider: graph or google.
model CalendarConnection {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  provider  String
  name      String
  sealed    String
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

// A meeting that has already started a room's calendar trigger, so it never runs twice.
model CalendarFire {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  roomId    String   @db.Uuid
  triggerId String
  eventKey  String
  firedAt   DateTime @default(now())

  @@unique([roomId, triggerId, eventKey])
  @@index([firedAt])
}

// The bookings for a room's panel, copied from its calendar by the calendar job (read only).
// Titles and organisers of private meetings are already removed. No relations: a row for a room
// that has since been deleted is harmless and is replaced or ignored.
model RoomSchedule {
  roomId    String   @id @db.Uuid
  orgId     String   @db.Uuid
  meetings  Json
  fetchedAt DateTime

  @@index([orgId])
}

// ---- Marketplace -------------------------------------------------------------------------------

// A room design shared by one organisation with others. `model` is a snapshot with every device
// setting removed (addresses and passwords never leave the publisher). status: pending (waiting for
// review), published, rejected, withdrawn. priceCents 0 is free.
model MarketplaceListing {
  id             String    @id @default(uuid()) @db.Uuid
  publisherOrgId String    @db.Uuid
  templateId     String?   @db.Uuid
  name           String
  description    String    @default("")
  roomType       RoomType
  model          Json
  version        Int       @default(1)
  priceCents     Int       @default(0)
  currency       String    @default("aud")
  status         String    @default("pending")
  reviewNote     String?
  downloads      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  publishedAt    DateTime?

  publisher Org                   @relation(fields: [publisherOrgId], references: [id], onDelete: Cascade)
  purchases MarketplacePurchase[]

  @@index([status, createdAt])
  @@index([publisherOrgId])
}

// An organisation's right to a listing, from a free download or a paid checkout.
model MarketplacePurchase {
  id              String   @id @default(uuid()) @db.Uuid
  listingId       String   @db.Uuid
  buyerOrgId      String   @db.Uuid
  priceCents      Int      @default(0)
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   Org                @relation(fields: [buyerOrgId], references: [id], onDelete: Cascade)

  @@unique([listingId, buyerOrgId])
}

// ---- Custom drivers ----------------------------------------------------------------------------

// A driver an organisation wrote in the Kestrel driver format. Each save is a new immutable
// version; a release pins the exact version it used, so changing a driver never changes a room
// that is already running.
model CustomDriver {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  slug          String
  name          String
  latestVersion Int      @default(1)
  createdAt     DateTime @default(now())

  org      Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions CustomDriverVersion[]

  @@unique([orgId, slug])
}

model CustomDriverVersion {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @db.Uuid
  version   Int
  spec      Json
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  driver CustomDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, version])
}

// Someone whose company already has an organisation on Kestrel asking its owners to add them. Only
// people with a confirmed email at the same company domain as an owner can ask, so a stranger can
// never ping an organisation by guessing its name.
model JoinRequest {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @db.Uuid
  userId    String    @db.Uuid
  email     String
  /// pending, approved, declined or cancelled.
  status    String    @default("pending")
  /// The role the owner gave when approving.
  role      OrgRole?
  createdAt DateTime  @default(now())
  decidedBy String?   @db.Uuid
  decidedAt DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([userId, createdAt])
}

// One free trial per person, per mailbox and per company domain, kept even if the organisation is
// later deleted. The unique columns make two sign-ups racing for the same trial safe: the second
// one's insert fails and it starts without a trial.
model TrialClaim {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  /// The address with +labels and Gmail dots removed.
  emailKey  String?  @unique
  /// The company domain, never a free mail provider.
  domainKey String?  @unique
  orgId     String?  @db.Uuid
  createdAt DateTime @default(now())
}

// ---- v2 (docs/pivot-monitoring.md): areas, devices as assets, device history -----------------------

/// A grouping of rooms inside a site that the customer chooses: a building, a level, a wing. Nests
/// (max depth 3, enforced in code). Rooms may sit in one area or none.
model Area {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  siteId    String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  /// What this level is called ("Building", "Level", "Zone"). Free text, shown as a small label.
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  org      Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   Area?  @relation("AreaTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Area[] @relation("AreaTree")
  rooms    Room[]

  @@unique([siteId, parentId, name])
  @@index([orgId])
  @@index([siteId])
}

/// A physical thing in a room, monitored or not. `active` devices are polled by a gateway through a
/// driver; `passive` ones are asset records only (a fixed source, a laptop, a camera, a media player)
/// and never show online or offline. This replaces the device list that used to live inside a room's
/// design. Which gateway polls an active device: its own `gatewayId`, else its room's, else the
/// site's default (resolved in code, see docs/pivot-monitoring.md).
model Device {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @db.Uuid
  siteId          String  @db.Uuid
  /// The room it is in. Null for a spare or a device shared by several rooms.
  roomId          String? @db.Uuid
  name            String
  /// active or passive
  kind            String  @default("passive")
  /// The device category (display, camera, dsp, laptop, media_player, ...).
  category        String
  /// Active only: { kind: "driver", driverId } or { kind: "generic", protocol }.
  control         Json?
  /// Active only: design settings the driver reads (not addresses or logins).
  settings        Json    @default("{}")
  /// Active only: addresses, setting key -> value.
  values          Json    @default("{}")
  /// Active only: logins sealed with KESTREL_SECRETS_KEY. Never sent to a browser.
  sealed          String?
  credentialSetId String? @db.Uuid
  /// Active only: the gateway that polls it. Null: the room's gateway, then the site's.
  gatewayId       String? @db.Uuid
  /// Goes up whenever anything a gateway needs (driver, address, login) changes.
  version         Int     @default(1)

  // Asset record. The value here is the one shown; `provenance` says where each came from.
  make              String?
  model             String?
  serial            String?
  mac               String?
  ip                String?
  firmware          String?
  assetTag          String?
  /// in_service, spare, in_repair, retired
  status            String    @default("in_service")
  installedOn       DateTime? @db.Date
  warrantyEndsOn    DateTime? @db.Date
  endOfLifeOn       DateTime? @db.Date
  supplier          String?
  notes             String?
  /// field -> { source: "discovered" | "manual", discovered?: value the device reported when it
  /// disagrees with the manual value, at: ISO time, by?: user id }.
  provenance        Json      @default("{}")
  /// The identity this record had before a confirmed replacement (old serial, mac, model, date).
  retiredIdentities Json      @default("[]")
  /// Set when a serial, MAC or model changed and nobody has said "replaced" or "correction" yet.
  swapPending       Boolean   @default(false)

  // Live state, written by heartbeats. online / offline. "unknown" is worked out at read time from
  // its gateway.
  online        Boolean?
  since         DateTime?
  lastSeenAt    DateTime?
  feedback      Json?
  details       Json?
  firmwareSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org     Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site    Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  room    Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  gateway Gateway?      @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  events  DeviceEvent[]

  @@index([orgId])
  @@index([siteId])
  @@index([roomId])
  @@index([gatewayId])
}

/// Append-only history of one device: field changes (old to new, who or what), moves, gateway
/// changes, swaps, and events copied in from elsewhere (incidents, PM results, drift). Kept for the
/// life of the device, not the 90 day telemetry window.
model DeviceEvent {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @db.Uuid
  deviceId String   @db.Uuid
  /// created, field_changed, moved, gateway_changed, swap_flagged, swap_confirmed, swap_dismissed,
  /// upgraded, status_changed, note
  type     String
  field    String?
  oldValue String?
  newValue String?
  /// discovered, manual or system
  source   String   @default("system")
  actorId  String?  @db.Uuid
  data     Json?
  at       DateTime @default(now())

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([deviceId, at])
}
