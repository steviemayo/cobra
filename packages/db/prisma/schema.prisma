generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  dev
  support
  customer_viewer
}

enum RoomType {
  meeting
  training
}

enum GatewayStatus {
  pending
  online
  offline
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members       Member[]
  sites         Site[]
  gateways      Gateway[]
  rooms         Room[]
  audit         AuditLog[]
  drafts        RoomDraft[]
  draftVersions RoomDraftVersion[]
  templates     Template[]
}

model Member {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String   @db.Uuid // Supabase auth.users.id
  role      OrgRole
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  timezone  String   @default("Australia/Sydney")
  createdAt DateTime @default(now())

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gateways Gateway[]
  rooms    Room[]

  @@index([orgId])
}

model Gateway {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  siteId          String        @db.Uuid
  name            String
  status          GatewayStatus @default(pending)
  enrollTokenHash String?
  lastSeenAt      DateTime?
  createdAt       DateTime      @default(now())

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([orgId])
  @@index([siteId])
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  siteId    String   @db.Uuid
  gatewayId String?  @db.Uuid
  name      String
  type      RoomType
  createdAt DateTime @default(now())

  org     Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site    Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gateway Gateway?   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  draft   RoomDraft?

  @@index([orgId])
  @@index([siteId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// One mutable working copy per room. `revision` gives optimistic concurrency for autosave.
model RoomDraft {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  roomId    String   @unique @db.Uuid
  revision  Int      @default(1)
  model     Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room     Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  versions RoomDraftVersion[]

  @@index([orgId])
}

// Named snapshots of a draft (manual checkpoints / restore points).
model RoomDraftVersion {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  draftId   String   @db.Uuid
  revision  Int
  label     String?
  model     Json
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  org   Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  draft RoomDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([orgId])
}

// Org-scoped room templates. Kestrel-global starters live in code (@kestrel/model).
model Template {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String   @default("")
  roomType    RoomType
  model       Json
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}
