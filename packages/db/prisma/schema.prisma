generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  dev
  support
  customer_viewer
}

enum RoomType {
  meeting
  training
}

enum GatewayStatus {
  pending
  online
  offline
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members       Member[]
  sites         Site[]
  gateways      Gateway[]
  rooms         Room[]
  audit         AuditLog[]
  drafts        RoomDraft[]
  draftVersions RoomDraftVersion[]
  templates     Template[]
  invites       Invite[]
  releases      Release[]
  gatewayEvents GatewayEvent[]
  deployments   Deployment[]
}

model Member {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String   @db.Uuid // Supabase auth.users.id
  email     String? // denormalised from auth.users for the team list
  role      OrgRole
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  timezone  String   @default("Australia/Sydney")
  createdAt DateTime @default(now())

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gateways Gateway[]
  rooms    Room[]

  @@index([orgId])
}

model Gateway {
  id                   String        @id @default(uuid()) @db.Uuid
  orgId                String        @db.Uuid
  siteId               String        @db.Uuid
  name                 String
  status               GatewayStatus @default(pending)
  enrollTokenHash      String?
  enrollTokenExpiresAt DateTime?
  credentialHash       String?       @unique
  enrolledAt           DateTime?
  version              String?
  hostname             String?
  os                   String?
  lastSeenAt           DateTime?
  createdAt            DateTime      @default(now())

  org    Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site   Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rooms  Room[]
  events GatewayEvent[]

  @@index([orgId])
  @@index([siteId])
}

model Room {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String    @db.Uuid
  siteId              String    @db.Uuid
  gatewayId           String?   @db.Uuid
  name                String
  type                RoomType
  createdAt           DateTime  @default(now())
  panel               Json?
  desiredReleaseId    String?   @db.Uuid
  desiredDeploymentId String?   @db.Uuid
  reportedReleaseId   String?   @db.Uuid
  reportedHash        String?
  reportedStatus      String?
  reportedError       String?
  reportedAt          DateTime?
  updatedAt           DateTime  @default(now()) @updatedAt

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gateway     Gateway?     @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  draft       RoomDraft?
  releases    Release[]
  deployments Deployment[]

  @@index([orgId])
  @@index([siteId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// One mutable working copy per room. `revision` gives optimistic concurrency for autosave.
model RoomDraft {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  roomId    String   @unique @db.Uuid
  revision  Int      @default(1)
  model     Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room     Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  versions RoomDraftVersion[]

  @@index([orgId])
}

// Named snapshots of a draft (manual checkpoints / restore points).
model RoomDraftVersion {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  draftId   String   @db.Uuid
  revision  Int
  label     String?
  model     Json
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  org   Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  draft RoomDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([orgId])
}

// Org-scoped room templates. Kestrel-global starters live in code (@kestrel/model).
model Template {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String   @default("")
  roomType    RoomType
  model       Json
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Invite links (no email delivery yet). Only the token hash is stored.
model Invite {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  email      String
  role       OrgRole
  tokenHash  String    @unique
  invitedBy  String?   @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// Immutable, signed snapshot of a room's design. `manifest` is the SignedManifest gateways run.
model Release {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  roomId        String   @db.Uuid
  number        Int
  manifest      Json
  hash          String
  /// Which revision of the draft this release froze, to tell when the design has moved on since.
  draftRevision Int?
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now())

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([roomId, number])
  @@index([orgId])
}

// Telemetry reported by gateways. Retention and rollups arrive with monitoring.
model GatewayEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  gatewayId  String   @db.Uuid
  roomId     String?  @db.Uuid
  type       String
  at         DateTime
  data       Json
  receivedAt DateTime @default(now())

  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId, at])
  @@index([orgId, at])
}

// One attempt to put a release on a room's gateway. `status` is scheduled, pending, one of the
// gateway stages (downloading ... active, failed, rolled_back), cancelled or superseded.
model Deployment {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  roomId       String    @db.Uuid
  releaseId    String    @db.Uuid
  gatewayId    String?   @db.Uuid
  status       String
  /// deploy, or rollback when it re-deploys an older release than the one that was running.
  kind         String    @default("deploy")
  scheduledFor DateTime?
  createdBy    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?

  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room    Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  release Release           @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  events  DeploymentEvent[]

  @@index([roomId, createdAt])
  @@index([orgId, createdAt])
  @@index([status, scheduledFor])
}

// A stage a deployment reached, with the gateway's own timestamp.
model DeploymentEvent {
  id           String   @id @default(uuid()) @db.Uuid
  deploymentId String   @db.Uuid
  stage        String
  at           DateTime

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, stage])
}
