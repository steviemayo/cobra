# Supabase (Sydney). DATABASE_URL = pooled (runtime), DIRECT_URL = direct (migrations)
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Release signing (generate with: pnpm --filter @kestrel/crypto keygen)
KESTREL_SIGNING_KEY=
KESTREL_SIGNING_KEY_ID=
# Optional: older public keys still trusted during a rotation, JSON [{"keyId","publicKeyPem"}]
KESTREL_EXTRA_PUBLIC_KEYS=
# Optional: image shown in the "add gateway" instructions
NEXT_PUBLIC_GATEWAY_IMAGE=
# Optional: overrides the Gateways page's Windows download link (default: /api/gateway/download,
# which proxies the gateway-stable release's KestrelGatewaySetup.exe through the server below)
NEXT_PUBLIC_GATEWAY_WINDOWS_URL=
# Lets /api/gateway/download fetch release assets from GitHub on people's behalf: the repo is
# private, so a direct releases/download link 404s for a signed-out visitor. A fine-grained PAT
# scoped to this repo with "Contents: Read" is enough
GITHUB_RELEASE_TOKEN=

# Monitoring and alerts
# Secret for scheduled jobs (/api/cron/*). Vercel sends it as a bearer token. 16+ characters
CRON_SECRET=
# Email alerts go through Resend. Leave empty to skip email channels
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Text message (SMS) alerts go through Twilio. Leave empty to skip SMS channels.
# TWILIO_FROM is a Twilio number in +61... format or an alphanumeric sender ID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public base URL of the portal, used for links in alerts
NEXT_PUBLIC_APP_URL=

# Billing (Stripe). Prices are per room per month; create them in the Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Encrypts calendar credentials and derives the signing secrets for phone (QR) control. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KESTREL_SECRETS_KEY=

# Staff portal (/staff). Staff are added with apps/web/scripts/add-staff.mts, not an env var.
# A second factor is required unless this is exactly "false" (local development only)
STAFF_REQUIRE_MFA=
# Optional: serve /staff only on this host, e.g. admin.example.com (see docs/staff-portal-and-msp.md)
STAFF_HOST=
# Where Kestrel staff are told about tickets escalated to them: a Teams incoming webhook or any webhook URL
STAFF_TICKET_WEBHOOK_URL=
# Comma separated addresses that get an email when a ticket is escalated to Kestrel.
# Needs RESEND_API_KEY and ALERT_FROM_EMAIL (above) to be set; otherwise nothing is sent.
STAFF_TICKET_EMAIL=
